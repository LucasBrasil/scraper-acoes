/** Representa as estatísticas calculadas para uma dezena. */
class Statistic {
  constructor(number, frequency, rankings, delay, windows, trend, score) {
    this.number = number;
    this.frequency = frequency;
    this.rankings = rankings;
    this.delay = delay;
    this.windows = windows;
    this.trend = trend;
    this.score = score;
  }
}
